{
  "name": "inquello-desktop",
  "productName": "Inquello",
  "version": "0.0.0",
  "private": true,
  "description": "Inquello desktop: Electron main process that owns the Codex app-server runtime over stdio.",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/check-data-policy.cjs && vite build",
    "test": "vitest run --configLoader runner",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "smoke": "pnpm run build && electron . --smoke"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
