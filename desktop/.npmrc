# Keep package caches and the Electron download cache on D: (see FORK-CUT.md, "Toolchain setup").
# pnpm exposes electron_config_cache to lifecycle scripts; scripts/install-electron.mjs reads it.
store-dir=D:/Toolchains/pnpm-store
cache-dir=D:/Toolchains/pnpm-cache
electron_config_cache=D:/Toolchains/electron-cache
save-exact=true
