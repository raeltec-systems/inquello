{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InquelloPolicySource": {
      "description": "The rule that governs a setting.",
      "properties": {
        "kind": {
          "description": "`workspace_policy`, `device_requirements`, `user_config` or `inquello_default`.",
          "type": "string"
        },
        "revision": {
          "description": "The Workspace policy revision, for `workspace_policy`.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "InquelloReceipt": {
      "description": "What a mutation's receipt recorded.",
      "properties": {
        "command": {
          "type": "string"
        },
        "expectedRevision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "operationId": {
          "type": "string"
        },
        "replayed": {
          "description": "True when this answer came from an earlier application of the operation.",
          "type": "boolean"
        },
        "resultingRevision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "command",
        "expectedRevision",
        "operationId",
        "replayed",
        "resultingRevision"
      ],
      "type": "object"
    },
    "InquelloRuntimeProfile": {
      "description": "A Task's tool profile in the runtime's own form (Story 1.19).",
      "properties": {
        "networkAllowlist": {
          "description": "The network allowlist through the runtime's proxy; null when unrestricted.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "permissionProfile": {
          "description": "The `[permissions.<id>]` table, when bounded."
        },
        "permissionProfileId": {
          "description": "The permissions profile id `inquello/tools/exec` applies, when bounded.",
          "type": [
            "string",
            "null"
          ]
        },
        "readableRoots": {
          "description": "Absolute folders the profile reads (beyond the runtime's minimal system set); empty when unbounded.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sandbox": {
          "description": "`permission-profile` (bounded: the named permissions profile below) or `danger-full-access` (a permitted Full access mode).",
          "type": "string"
        },
        "writableRoots": {
          "description": "Absolute folders the profile writes; empty when unbounded.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "readableRoots",
        "sandbox",
        "writableRoots"
      ],
      "type": "object"
    },
    "InquelloTaskBroadMode": {
      "description": "A Task's broader execution mode under the current policy.",
      "properties": {
        "effectiveMode": {
          "description": "The mode the Task runs in: `standard` when suspended.",
          "type": "string"
        },
        "governing": {
          "anyOf": [
            {
              "$ref": "#/definitions/InquelloPolicySource"
            },
            {
              "type": "null"
            }
          ],
          "description": "The rule that suspends the recorded mode, when suspended."
        },
        "label": {
          "description": "Always \"Broader execution mode\".",
          "type": "string"
        },
        "reach": {
          "description": "The reach statement of the recorded mode.",
          "type": "string"
        },
        "recorded": {
          "description": "The recorded mode: `standard`, `no_prompt` or `full_access`.",
          "type": "string"
        },
        "revision": {
          "description": "The Task's broad-mode revision: 0 before the first record.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "description": "`standard`, `active` or `suspended` (recorded but no longer permitted).",
          "type": "string"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "effectiveMode",
        "label",
        "reach",
        "recorded",
        "revision",
        "status",
        "taskId"
      ],
      "type": "object"
    },
    "InquelloTaskPolicy": {
      "properties": {
        "broadMode": {
          "$ref": "#/definitions/InquelloTaskBroadMode"
        },
        "reach": {
          "allOf": [
            {
              "$ref": "#/definitions/InquelloToolReach"
            }
          ],
          "description": "Story 1.19: what the Task's tools can reach, without device paths."
        },
        "runtimeProfile": {
          "anyOf": [
            {
              "$ref": "#/definitions/InquelloRuntimeProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Story 1.19: the tool profile in the runtime's own form; present when the params name the Task folder."
        },
        "threadSettings": {
          "$ref": "#/definitions/InquelloThreadSettings"
        }
      },
      "required": [
        "broadMode",
        "reach",
        "threadSettings"
      ],
      "type": "object"
    },
    "InquelloThreadSettings": {
      "description": "The thread settings a run of the Task gets, derived only from the effective policy and the Task's broad mode. Values use the runtime's own names.",
      "properties": {
        "approvalPolicy": {
          "description": "`untrusted`, `on-request` or `never`.",
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "networkAccess": {
          "type": "boolean"
        },
        "sandbox": {
          "description": "`read-only`, `workspace-write` or `danger-full-access`.",
          "type": "string"
        }
      },
      "required": [
        "approvalPolicy",
        "mode",
        "networkAccess",
        "sandbox"
      ],
      "type": "object"
    },
    "InquelloToolBoundary": {
      "description": "One permitted location of a bounded tool profile (Story 1.19).",
      "properties": {
        "access": {
          "description": "`read` or `write`.",
          "type": "string"
        },
        "kind": {
          "description": "`working_folder`, `output_folder` or `system`.",
          "type": "string"
        },
        "label": {
          "description": "The boundary's name in a denial, for example \"working folder (read/write)\", \"output folder\" or \"system (read-only)\".",
          "type": "string"
        }
      },
      "required": [
        "access",
        "kind",
        "label"
      ],
      "type": "object"
    },
    "InquelloToolReach": {
      "description": "What a Task's tools can reach (Story 1.19), with no device path.",
      "properties": {
        "boundaries": {
          "description": "The permitted locations of a bounded profile; empty when unbounded.",
          "items": {
            "$ref": "#/definitions/InquelloToolBoundary"
          },
          "type": "array"
        },
        "bounded": {
          "description": "False only for a permitted Full access broad mode: no filesystem or network limits.",
          "type": "boolean"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "network": {
          "description": "`listed` (only `domains`; none when empty) or `unrestricted`.",
          "type": "string"
        },
        "networkSource": {
          "allOf": [
            {
              "$ref": "#/definitions/InquelloPolicySource"
            }
          ],
          "description": "The rule that governs the network reach."
        }
      },
      "required": [
        "boundaries",
        "bounded",
        "domains",
        "network",
        "networkSource"
      ],
      "type": "object"
    }
  },
  "properties": {
    "receipt": {
      "$ref": "#/definitions/InquelloReceipt"
    },
    "task": {
      "$ref": "#/definitions/InquelloTaskPolicy"
    }
  },
  "required": [
    "receipt",
    "task"
  ],
  "title": "InquelloBroadModeSetResponse",
  "type": "object"
}