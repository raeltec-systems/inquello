{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InquelloCapabilityContractEntry": {
      "description": "A Capability Contract entry from the compiled capability register.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "id",
        "limits"
      ],
      "type": "object"
    },
    "InquelloDeviceRequirements": {
      "description": "The device layer as `configRequirements/read` reports it.",
      "properties": {
        "approvals": {
          "description": "Allowed approval behaviours, or null when not configured.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "configured": {
          "description": "False when no requirement this policy reads is configured.",
          "type": "boolean"
        },
        "sandboxModes": {
          "description": "Allowed sandbox levels, or null when not configured.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "configured"
      ],
      "type": "object"
    },
    "InquelloPolicySetting": {
      "description": "One effective setting.",
      "properties": {
        "name": {
          "description": "`sandbox`, `approval`, `network`, `mcp_tools`, `extensions`, `full_access` or `no_prompt`.",
          "type": "string"
        },
        "restricted": {
          "description": "Whether a rule narrows the setting below its most permissive value.",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/InquelloPolicySource"
        },
        "value": {
          "description": "`read_only`/`workspace_write`/`full_access` for `sandbox` (the ceiling); `on_request`/`untrusted` for `approval`; `allowed`/`denied` for `network`, `mcp_tools` and `extensions`; `permitted`/`not_permitted` for the broad modes.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "restricted",
        "source",
        "value"
      ],
      "type": "object"
    },
    "InquelloPolicySource": {
      "description": "The rule that governs a setting.",
      "properties": {
        "kind": {
          "description": "`workspace_policy`, `device_requirements`, `user_config` or `inquello_default`.",
          "type": "string"
        },
        "revision": {
          "description": "The Workspace policy revision, for `workspace_policy`.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "InquelloTaskBroadMode": {
      "description": "A Task's broader execution mode under the current policy.",
      "properties": {
        "effectiveMode": {
          "description": "The mode the Task runs in: `standard` when suspended.",
          "type": "string"
        },
        "governing": {
          "anyOf": [
            {
              "$ref": "#/definitions/InquelloPolicySource"
            },
            {
              "type": "null"
            }
          ],
          "description": "The rule that suspends the recorded mode, when suspended."
        },
        "label": {
          "description": "Always \"Broader execution mode\".",
          "type": "string"
        },
        "reach": {
          "description": "The reach statement of the recorded mode.",
          "type": "string"
        },
        "recorded": {
          "description": "The recorded mode: `standard`, `no_prompt` or `full_access`.",
          "type": "string"
        },
        "revision": {
          "description": "The Task's broad-mode revision: 0 before the first record.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "description": "`standard`, `active` or `suspended` (recorded but no longer permitted).",
          "type": "string"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "effectiveMode",
        "label",
        "reach",
        "recorded",
        "revision",
        "status",
        "taskId"
      ],
      "type": "object"
    },
    "InquelloTaskPolicy": {
      "properties": {
        "broadMode": {
          "$ref": "#/definitions/InquelloTaskBroadMode"
        },
        "threadSettings": {
          "$ref": "#/definitions/InquelloThreadSettings"
        }
      },
      "required": [
        "broadMode",
        "threadSettings"
      ],
      "type": "object"
    },
    "InquelloThreadSettings": {
      "description": "The thread settings a run of the Task gets, derived only from the effective policy and the Task's broad mode. Values use the runtime's own names.",
      "properties": {
        "approvalPolicy": {
          "description": "`untrusted`, `on-request` or `never`.",
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "networkAccess": {
          "type": "boolean"
        },
        "sandbox": {
          "description": "`read-only`, `workspace-write` or `danger-full-access`.",
          "type": "string"
        }
      },
      "required": [
        "approvalPolicy",
        "mode",
        "networkAccess",
        "sandbox"
      ],
      "type": "object"
    }
  },
  "properties": {
    "authorizationEpoch": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "capabilities": {
      "description": "Capability Contract entries that are listed but not enabled.",
      "items": {
        "$ref": "#/definitions/InquelloCapabilityContractEntry"
      },
      "type": "array"
    },
    "device": {
      "$ref": "#/definitions/InquelloDeviceRequirements"
    },
    "environment": {
      "description": "Always `local_device` in V1.",
      "type": "string"
    },
    "policyRevision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "settings": {
      "description": "Every setting, in a fixed order.",
      "items": {
        "$ref": "#/definitions/InquelloPolicySetting"
      },
      "type": "array"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/definitions/InquelloTaskPolicy"
        },
        {
          "type": "null"
        }
      ],
      "description": "Present when the params name a Task."
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "authorizationEpoch",
    "capabilities",
    "device",
    "environment",
    "policyRevision",
    "settings",
    "workspaceId"
  ],
  "title": "InquelloPolicyEffectiveResponse",
  "type": "object"
}