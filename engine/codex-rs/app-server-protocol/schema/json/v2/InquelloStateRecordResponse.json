{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InquelloReceipt": {
      "description": "What a mutation's receipt recorded.",
      "properties": {
        "command": {
          "type": "string"
        },
        "expectedRevision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "operationId": {
          "type": "string"
        },
        "replayed": {
          "description": "True when this answer came from an earlier application of the operation.",
          "type": "boolean"
        },
        "resultingRevision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "command",
        "expectedRevision",
        "operationId",
        "replayed",
        "resultingRevision"
      ],
      "type": "object"
    },
    "InquelloStateRecord": {
      "description": "One immutable state record.",
      "properties": {
        "actorKind": {
          "description": "`human`, `runtime` or `system`.",
          "type": "string"
        },
        "actorRef": {
          "description": "The principal ID for a human; the runtime or host name otherwise.",
          "type": "string"
        },
        "dimension": {
          "description": "`task`, `run`, `output`, `checks`, `review`, `approval_marker` or `delivery_marker`.",
          "type": "string"
        },
        "recordedAt": {
          "description": "Milliseconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "description": "The Task-state revision this record created.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "scopeId": {
          "description": "The Task ID, a run reference or an output/version reference.",
          "type": "string"
        },
        "scopeKind": {
          "description": "`task`, `run` or `output`.",
          "type": "string"
        },
        "value": {
          "description": "A value of the dimension's own vocabulary.",
          "type": "string"
        },
        "version": {
          "description": "1 for the first record of this dimension and scope, then one more per record.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "actorKind",
        "actorRef",
        "dimension",
        "recordedAt",
        "revision",
        "scopeId",
        "scopeKind",
        "value",
        "version"
      ],
      "type": "object"
    }
  },
  "properties": {
    "receipt": {
      "$ref": "#/definitions/InquelloReceipt"
    },
    "record": {
      "$ref": "#/definitions/InquelloStateRecord"
    },
    "taskId": {
      "type": "string"
    }
  },
  "required": [
    "receipt",
    "record",
    "taskId"
  ],
  "title": "InquelloStateRecordResponse",
  "type": "object"
}